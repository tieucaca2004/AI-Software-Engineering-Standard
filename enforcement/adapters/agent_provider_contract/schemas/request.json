{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ases-exec-request/1",
  "type": "object",
  "required": ["schema", "request_id", "work_unit_id", "authorization_decision_ref",
               "approved_scope_ref", "objective", "working_directory", "instructions", "config"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "ases-exec-request/1"},
    "request_id": {"type": "string", "minLength": 1},
    "work_unit_id": {"type": "string", "minLength": 1},
    "authorization_decision_ref": {"type": "string", "minLength": 1},
    "approved_scope_ref": {"type": "string", "minLength": 1},
    "baseline_ref": {"type": ["string", "null"], "minLength": 1},
    "intent_decision_ref": {"type": ["string", "null"], "minLength": 1},
    "objective": {"type": "string"},
    "working_directory": {"type": "string"},
    "instructions": {"type": "string"},
    "config": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string"},
        "permission_mode": {"type": "string"},
        "allowed_tools": {"type": "array", "items": {"type": "string"}},
        "disallowed_tools": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
