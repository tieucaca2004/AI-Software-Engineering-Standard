{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ases-usage/1",
  "type": "object",
  "required": ["schema", "request_id", "work_unit_id", "provider_id", "source", "completeness",
               "input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens",
               "captured_utc"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "ases-usage/1"},
    "request_id": {"type": "string", "minLength": 1},
    "work_unit_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["provider-reported", "estimated", "unavailable"]},
    "completeness": {"enum": ["complete", "partial", "unavailable"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_creation_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_read_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "thinking_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "captured_utc": {"type": "string", "minLength": 1},
    "raw_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
